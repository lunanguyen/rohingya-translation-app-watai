# URL printed by the Colab notebook (colab/mms_model_server.ipynb) after it starts the ngrok tunnel.
# Example: https://abcd-1234.ngrok-free.app
MODEL_SERVER_URL=

# Gemini API key, used as the translation fallback for anything not in the
# verified phrasebook (data/phrases.json). Get a free one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Whisper model size for English ASR (runs locally on CPU). "base" is a good
# speed/accuracy tradeoff for short utterances; use "small" if CPU is fast enough.
WHISPER_MODEL_SIZE=base
